{
  "manifest_version": 3,
  "name": "MeowBlocker",
  "version": "1.0",
  "description": "Honest in-browser ad blocker with per-site whitelist",
  "icons": {
    "16": "meowblocker-logo.png",
    "32": "meowblocker-logo.png",
    "48": "meowblocker-logo.png",
    "128": "meowblocker-logo.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "meowblocker-toolbar.png",
      "32": "meowblocker-toolbar.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "meowblocker_blocklist",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}